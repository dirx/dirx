---
const { currentPath } = Astro.props;
const links = [
  { href: '/artworks-and-projects/', label: 'artworks & projects' },
  { href: '/open-source-projects/', label: 'open source' },
];
---

<header class="mx-auto flex max-w-3xl items-start justify-between gap-6 px-5 pt-5 sm:px-8">
  <a class="block h-28 w-28 shrink-0 bg-[url('/assets/logos/dirx-400x400.png')] bg-contain bg-no-repeat bg-[-34px] sm:h-36 sm:w-36 sm:bg-[-42px]" href="/" aria-label="dirx.dev home"></a>
  <div class="relative pt-5 sm:hidden">
    <button type="button" aria-expanded="false" aria-controls="mobile-navigation" data-menu-toggle class="cursor-pointer text-sm underline decoration-zinc-400 underline-offset-4">menu</button>
    <ul id="mobile-navigation" data-mobile-menu class="absolute right-0 z-10 mt-3 hidden w-52 flex-col gap-2 bg-white p-4 text-right shadow-lg">
      {links.map((link) => (
        <li>
          <a class:list={['text-sm no-underline hover:underline sm:text-base', { 'font-medium underline': currentPath === link.href }]} href={link.href} aria-current={currentPath === link.href ? 'page' : undefined}>{link.label}</a>
        </li>
      ))}
    </ul>
  </div>
  <nav aria-label="Primary navigation" class="hidden pt-7 sm:block">
    <ul class="flex gap-5">
      {links.map((link) => (
        <li>
          <a class:list={['text-base no-underline hover:underline', { 'underline': currentPath === link.href }]} href={link.href} aria-current={currentPath === link.href ? 'page' : undefined}>{link.label}</a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');

  toggle?.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!isOpen));
    menu?.classList.toggle('hidden', isOpen);
    menu?.classList.toggle('flex', !isOpen);
  });
</script>
