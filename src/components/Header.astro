---
import { Icon } from 'astro-icon/components';

const { currentPath } = Astro.props;
const links = [
  { href: '/artworks-and-projects/', label: 'artworks & projects' },
  { href: '/open-source-projects/', label: 'open source' },
];
---

<header class="site-header mx-auto flex max-w-3xl items-start justify-between gap-3 px-5 pt-5 sm:gap-6 sm:px-8">
  <a class="site-title block h-28 w-28 shrink-0 bg-[url('/assets/logos/dirx-400x400.png')] bg-contain bg-no-repeat bg-[-34px] sm:h-36 sm:w-36 sm:bg-[-42px]" href="/" aria-label="dirx.dev home"></a>
  <div class="flex flex-col items-end gap-4 pt-5">
    <div class="relative sm:hidden">
      <button type="button" aria-label="Menu" aria-expanded="false" aria-controls="mobile-navigation" data-menu-toggle class="menu-toggle"><Icon name="material-symbols-light:menu-outline-rounded" size="20" aria-hidden="true" /></button>
      <ul id="mobile-navigation" data-mobile-menu class="mobile-menu absolute right-0 z-10 mt-3 hidden w-52 flex-col gap-2 p-4 text-right">
        {links.map((link) => (
          <li>
            <a class:list={['text-[18px] no-underline hover:underline', { 'underline': currentPath === link.href }]} href={link.href} aria-current={currentPath === link.href ? 'page' : undefined}>{link.label}</a>
          </li>
        ))}
      </ul>
    </div>
    <nav aria-label="Primary navigation" class="hidden sm:block">
      <ul class="flex gap-5">
        {links.map((link) => (
          <li>
            <a class:list={['text-[18px] no-underline hover:underline', { 'underline': currentPath === link.href }]} href={link.href} aria-current={currentPath === link.href ? 'page' : undefined}>{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  const logo = document.querySelector<HTMLElement>('.site-title');
  const hue = Math.floor(Math.random() * 11) * 29;
  const adjustedHue = hue > 170 ? hue + 10 : hue;
  const brightness = adjustedHue > 60 && adjustedHue < 180 ? 1.6 : 1.4;
  const saturation = adjustedHue > 60 && adjustedHue < 140 ? 1.4 : 1.0;

  if (logo) {
    logo.style.filter = `hue-rotate(${adjustedHue}deg) brightness(${brightness}) saturate(${saturation})`;
  }

  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');

  toggle?.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!isOpen));
    menu?.classList.toggle('hidden', isOpen);
    menu?.classList.toggle('flex', !isOpen);
  });
</script>
